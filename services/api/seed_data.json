        "prompt": [
          {
            "type": "text",
            "text": "如图，在 $\\triangle ABC$ 中，$D$、$E$ 分别在 $AB$、$AC$ 边上，若 $DE \\parallel BC$，且 $\\frac{AD}{DB} = \\frac{2}{3}$，则 $\\frac{S_{\\triangle ADE}}{S_{\\triangle ABC}}$ 的值为（　　）"
          }
        ],
        "options": [
          {
            "id": "opt_A",
            "label": "A",
