              {
                "type": "text",
                "text": "$\\frac{2}{5}$"
              }
            ]
          },
          {
            "id": "opt_B",
            "label": "B",
            "content": [
              {
                "type": "text",
                "text": "$\\frac{4}{9}$"
              }
            ]
          },
          {
            "id": "opt_C",
            "label": "C",
            "content": [
              {
                "type": "text",
                "text": "$\\frac{4}{25}$"
              }
