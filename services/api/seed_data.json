      },
      "private": {
        "answers": [
          {
            "target_local_id": "slot_02",
            "answer_text": "C",
            "selected_option_ids": [
              "opt_C"
            ],
            "explanation": [
              {
                "type": "text",
                "text": "∵ $\\frac{AD}{DB} = \\frac{2}{3}$，∴ $\\frac{AD}{AB} = \\frac{AD}{AD + DB} = \\frac{2}{2 + 3} = \\frac{2}{5}$。"
              },
              {
                "type": "text",
                "text": "∵ $DE \\parallel BC$，∴ $\\triangle ADE \\sim \\triangle ABC$。"
              },
              {
                "type": "text",
                "text": "相似三角形的面积比等于相似比的平方："
              },
              {
                "type": "math",
                "latex": "\\frac{S_{\\triangle ADE}}{S_{\\triangle ABC}} = \\left(\\frac{AD}{AB}\\right)^2 = \\left(\\frac{2}{5}\\right)^2 = \\frac{4}{25}"
              },
              {
                "type": "text",
                "text": "故选 C。"
              }
