# 知卷本地运行配置模板（configs/local-runtime.env.example）
#
# 本文件只含占位符，从不存放真实密钥。复制为受保护的本地运行环境（配合
# 根 .env 由 tools/local_runtime.py 按键值数据读取，禁止 source、禁止 shell
# 解析——当前 DATABASE_URL 是含空格的 libpq conninfo，不是可信 Shell 脚本）。
#
# 变量来源：实施计划 §6.2（本地运行接线）与跨任务契约 C4（设置）。
#
# 说明：CELERY_BROKER_URL、DATABASE_URL、Hermes 网关与模型 ID 必须与 API/
# Worker/调度器三者完全一致；模型 ID 与 Hermes、预算代理允许的模型一致，
# 不能省略设置而回退到别的默认模型。

# --- 数据库 / 队列（API、Worker、调度器共用同一套） --------------------

# 日常库 DSN。libpq conninfo 允许含空格，本工具按键值加载不会拆坏。
# 三个进程必须指向同一个 zhijuan_local。
DATABASE_URL=user=zhijuan_workflow password=REPLACE_WITH_LOCAL_PASSWORD dbname=zhijuan_local host=127.0.0.1 port=55432

# AMQP 连接串，vhost 用 zhijuan-local（验收与日常 broker 严格隔离）。
# 密码字段仅占位，真实口令只存在于本机环境，绝不写入本文件或日志。
CELERY_BROKER_URL=amqp://zhijuan_dev:REPLACE_WITH_BROKER_PASSWORD@127.0.0.1:55672/zhijuan-local

# --- Hermes 网关（author / solver） --------------------------------------

# author 网关 base URL（默认 127.0.0.1:8644）。不要追加 /v1：
# 适配器自己拼接 /v1/runs。
HERMES_API_BASE_URL=http://127.0.0.1:8644

# author 内部令牌（不是官方 API key）。只进内存，不输出、不落日志。
HERMES_API_KEY=REPLACE_WITH_AUTHOR_INTERNAL_TOKEN

# solver-entry base URL（默认 127.0.0.1:8643）。也不要追加 /v1：
# 这是隔离网关精确白名单路由，不是 solver 上游直出。
HERMES_SOLVER_API_BASE_URL=http://127.0.0.1:8643

# solver-entry 内部令牌（与 author 令牌不同，gateway 角色隔离）。
HERMES_SOLVER_API_KEY=REPLACE_WITH_SOLVER_INTERNAL_TOKEN

# solver-entry 通往隔离 solver 的上游密钥（solver 容器持有）。
# 不给前端，不传给 author。
HERMES_SOLVER_UPSTREAM_KEY=REPLACE_WITH_SOLVER_UPSTREAM_KEY

# --- 模型 / 预算 ---------------------------------------------------------

# Worker/API/心跳声明的模型 ID，必须与 Hermes 与预算代理允许的模型一致。
# 注意：容器内 DEEPSEEK_BASE_URL=http://budget-proxy:8650/v1 是含 /v1 的，
# 那是代理可达名，与上方两个不含 /v1 的网关 base URL 是不同的变量。
ZHIJUAN_DEEPSEEK_MODEL_ID=deepseek-flash

# 预算代理内部令牌（C3 /internal/budget 鉴权）。默认空 = 预算不可用，
# 就绪检查会给出 BUDGET 相关原因码。真实值只进内存。
ZHIJUAN_BUDGET_PROXY_TOKEN=REPLACE_WITH_BUDGET_INTERNAL_TOKEN

# 只读预算状态接口（C3：不预留、不调用上游、不改账本）。
ZHIJUAN_BUDGET_INTERNAL_URL=http://127.0.0.1:8650/internal/budget

# 预算账本路径（沿用现有 /tmp 路径；迁移前先停代理备份再动）。
# 仅供费用代理使用，本工具只读预算状态不接触账本文件。
ZHIJUAN_BUDGET_LEDGER_PATH=/tmp/zhijuan-workflow-20260922/budget/acceptance.sqlite

# --- 运行元数据（C4 / 心跳） --------------------------------------------

# 非秘密的本地部署 ID，用于排除错误环境的心跳；API 只接受同 ID 的心跳。
ZHIJUAN_RUNTIME_ID=zhijuan-local

# 心跳过期阈值（秒）。Worker 每 5 秒、调度器每 tick 一次心跳 upsert。
ZHIJUAN_HEARTBEAT_TTL_SECONDS=20

# 就绪探测总时间预算（秒）与 /readyz 短 TTL 缓存（秒）。本工具 doctor 与
# start-generation 都以此为探测超时。
ZHIJUAN_READINESS_PROBE_TIMEOUT=2.0
ZHIJUAN_READINESS_CACHE_TTL=3.0

# --- 官方上游密钥（由本机受信凭据源注入，绝不放在本文件或命令行） -------

# DEEPSEEK_UPSTREAM_API_KEY 只交给预算代理（唯一官方模型出口）单独持有。
# 本 .example 只写占位，代理运行环境从受限凭据源注入。
DEEPSEEK_UPSTREAM_API_KEY=REPLACE_FROM_SECURE_CREDENTIAL_SOURCE_ONLY
DEEPSEEK_API_KEY=REPLACE_FROM_SECURE_CREDENTIAL_SOURCE_ONLY
DEEPSEEK_BASE_URL=https://api.deepseek.com

# API 服务内部密钥（若有，用于服务间鉴权；无则保持空）。
API_SERVER_KEY=
