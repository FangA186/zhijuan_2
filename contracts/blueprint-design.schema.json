{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "conflicts",
    "slots"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "conflicts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "slots": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "knowledge_ids",
          "cognitive_target",
          "difficulty",
          "design_brief",
          "rationale"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "knowledge_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "cognitive_target": {
            "type": "string",
            "minLength": 2,
            "maxLength": 300
          },
          "difficulty": {
            "enum": [
              "basic",
              "medium",
              "advanced"
            ]
          },
          "design_brief": {
            "type": "string",
            "minLength": 8,
            "maxLength": 800
          },
          "rationale": {
            "type": "string",
            "minLength": 4,
            "maxLength": 500
          }
        }
      }
    }
  }
}
