# Merge with an existing project's ignore policy; do not overwrite it blindly.
.venv/
venv/
__pycache__/
*.py[cod]
node_modules/
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
progress/generated/
acceptance-runs/ci/
acceptance-runs/devtools/local-*/
smartedu_data/
# Reviewed, redacted release evidence may be committed explicitly.
vendor/hermes-agent/
.DS_Store

# Local runtime PID/log directory created by tools/local_runtime.py
.runtime/

# Local textbook images and acceptance screenshots stay on disk, outside Git.
/教材单词图片/**/*.[pP][nN][gG]
/教材单词图片/**/*.[jJ][pP][gG]
/教材单词图片/**/*.[jJ][pP][eE][gG]
/教材单词图片_非课程教学备份/**/*.[pP][nN][gG]
/教材单词图片_非课程教学备份/**/*.[jJ][pP][gG]
/教材单词图片_非课程教学备份/**/*.[jJ][pP][eE][gG]
/acceptance-runs/**/*.[pP][nN][gG]
/acceptance-runs/**/*.[jJ][pP][gG]
/acceptance-runs/**/*.[jJ][pP][eE][gG]

# Local teaching data, uploads and generated working files (not source code).
/教材单词图片/
/教材单词图片_非课程教学备份/
/uploads/
/.zcode/workflow-drafts/
/tools/bin/mac_vision_ocr
/tools/crawler/smartedu_preview.html

# Keep acceptance reports and reproducible source scripts; leave run output local.
/acceptance-runs/**/*
!/acceptance-runs/**/
!/acceptance-runs/**/*.md
!/acceptance-runs/**/report.json
!/acceptance-runs/**/summary.json
!/acceptance-runs/**/usage-summary.json
!/acceptance-runs/**/*.py
!/acceptance-runs/**/*.sh
/acceptance-runs/**/*.before.md
# Preserve the existing CI and machine-local evidence exclusions.
/acceptance-runs/ci/
/acceptance-runs/devtools/local-*/

# Database dumps and copied originals are runtime artifacts, never report source.
/acceptance-runs/**/backup/
